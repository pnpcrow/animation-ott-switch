{
  "name": "animation-ott-switch",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "description": "Local-first Chrome extension for cross-OTT discovery and a personal title library",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:decision-eval": "node --test eval/tiny-decision/dataset.test.mjs eval/tiny-decision/challenge.test.mjs eval/tiny-decision/metrics.test.mjs eval/tiny-decision/report.test.mjs eval/tiny-decision/title-recovery.test.mjs eval/tiny-decision/needle3/templates.test.mjs",
    "test:decision-eval-v2": "node scripts/test-decision-v2.mjs",
    "test:light-dom": "node scripts/test-light-dom.mjs",
    "test:dom-adaptation": "node scripts/test-dom-adaptation.mjs",
    "test:dom-scale": "node scripts/test-dom-scale.mjs",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "package": "npm run build && node scripts/package.mjs",
    "format": "prettier --write src tests scripts public/*.json *.json *.ts docs/*.md README.md"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "linkedom": "^0.18.12",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/chrome": "^0.1.36",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "fflate": "^0.8.2",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
