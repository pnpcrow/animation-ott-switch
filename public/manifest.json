{
  "manifest_version": 3,
  "name": "OTT Switch · 작품 보관함",
  "version": "0.1.2",
  "description": "보고 싶은 작품을 다른 OTT에서 찾아 이동하고, 카테고리별로 나만의 작품 보관함을 만드세요.",
  "minimum_chrome_version": "120",
  "permissions": ["storage"],
  "host_permissions": [
    "https://laftel.net/*",
    "https://www.laftel.net/*",
    "https://api.laftel.net/*",
    "https://www.aniplustv.com/*",
    "https://aniplustv.com/*",
    "https://www.crunchyroll.com/*",
    "https://crunchyroll.com/*",
    "https://www.netflix.com/*",
    "https://netflix.com/*",
    "https://www.primevideo.com/*",
    "https://primevideo.com/*",
    "https://tv.apple.com/*",
    "https://www.wavve.com/*",
    "https://wavve.com/*",
    "https://www.tving.com/*",
    "https://tving.com/*",
    "https://www.coupangplay.com/*",
    "https://coupangplay.com/*",
    "https://watcha.com/*",
    "https://www.watcha.com/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "OTT Switch 보관함 열기",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "options_page": "library.html",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://laftel.net/*",
        "https://www.laftel.net/*",
        "https://www.aniplustv.com/*",
        "https://aniplustv.com/*",
        "https://www.crunchyroll.com/*",
        "https://crunchyroll.com/*",
        "https://www.netflix.com/*",
        "https://netflix.com/*",
        "https://www.primevideo.com/*",
        "https://primevideo.com/*",
        "https://tv.apple.com/*",
        "https://www.wavve.com/*",
        "https://wavve.com/*",
        "https://www.tving.com/*",
        "https://tving.com/*",
        "https://www.coupangplay.com/*",
        "https://coupangplay.com/*",
        "https://watcha.com/*",
        "https://www.watcha.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
